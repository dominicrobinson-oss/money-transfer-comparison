# Database configuration
# For SQLite (development)
DATABASE_URL="file:./dev.db"

# For PostgreSQL (production - uncomment when ready)
# DATABASE_URL="postgresql://user:password@host:5432/database_name"

# API Configuration
NEXT_PUBLIC_API_URL="http://localhost:3000"

# For Vercel production deployment
# NEXT_PUBLIC_API_URL="https://your-domain.vercel.app"

# Quote Fetch Configuration
# Timeout for each provider API call (milliseconds)
# Default: 15000 (15 seconds)
QUOTE_FETCH_TIMEOUT_MS=15000

# Application Environment
# development | production | test
NODE_ENV=development

# Vercel Cron Security (if using Vercel)
# Random secret token to secure the /api/cron/fetch-live-quotes endpoint
# Generate with: openssl rand -base64 32
VERCEL_CRON_SECRET=

# Analytics & Telemetry
# Enable telemetry data collection
NEXT_PUBLIC_TELEMETRY_ENABLED=true

# Next.js Configuration
# Enable debug logging (development only)
DEBUG=

# Vercel Analytics Integration (optional)
# VERCEL_ANALYTICS_ID=your-analytics-id