[Unit]
Description=Fetch live money transfer quotes
Documentation=https://github.com/your-org/money-transfer-comparison
After=network.target

[Service]
Type=oneshot
User=app-user
WorkingDirectory=/opt/money-transfer-comparison
Environment="NODE_ENV=production"
Environment="PATH=/opt/money-transfer-comparison/node_modules/.bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/npm run fetch:live-quotes

# Allow service to continue even if script fails
RemainAfterExit=yes

# Log output
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fetch-live-quotes

[Install]
WantedBy=multi-user.target
